[Unit]
Description=ONVIF Viewer - interfaccia web di configurazione
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=onvifview
Group=onvifview
Environment=HOME=/var/lib/onvif-viewer
Environment=PYTHONUNBUFFERED=1
Environment=WEB_PORT=80
ExecStart=/usr/bin/python3 /opt/onvif-viewer/app/web.py
Restart=always
RestartSec=3
# Porta 80 senza root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/onvif-viewer

[Install]
WantedBy=multi-user.target
